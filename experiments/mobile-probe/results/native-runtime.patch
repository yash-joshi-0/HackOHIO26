+    shard_end = hparams.n_layer();
+    const char * range = std::getenv("MESHTHING_SHARD");
+    if (params.shard_end >= 0) {
+        shard_begin = params.shard_begin;
+        shard_end = params.shard_end;
+    } else if (range) {
+        char trailing;
+        if (sscanf(range, "%d:%d%c", &shard_begin, &shard_end, &trailing) != 2) {
+            throw std::runtime_error("invalid MESHTHING_SHARD syntax");
+        }
+    }
+    if (params.shard_end >= 0 || range) {
+        if (shard_begin < 0 || shard_end <= shard_begin || shard_end > (int) hparams.n_layer() ||
+                (arch != LLM_ARCH_LLAMA && arch != LLM_ARCH_QWEN2 && arch != LLM_ARCH_DEEPSEEK2) ||
+                (arch != LLM_ARCH_DEEPSEEK2 && hparams.n_expert > 0)) {
+            throw std::runtime_error("invalid/unsupported MESHTHING_SHARD range or architecture");
+        }
+        LLAMA_LOG_INFO("mesh shard: layers [%d, %d) of %u\n", shard_begin, shard_end, hparams.n_layer());
+    }
+    uint32_t stored_begin = 0, stored_end = 0;
+    const bool has_begin = ml.get_key("meshthing.shard_begin", stored_begin, false);
+    const bool has_end = ml.get_key("meshthing.shard_end", stored_end, false);
+    if (has_begin != has_end || (has_begin &&
+            (stored_begin != (uint32_t) shard_begin || stored_end != (uint32_t) shard_end))) {
+        throw std::runtime_error("exported shard range does not match requested partition");
